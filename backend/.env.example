NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://p4s:p4s@localhost:5432/p4s_dev

# JWT (HS256). Mínimo 32 caracteres. Gerar com: openssl rand -base64 48
JWT_SECRET=troca-isto-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Custo do bcrypt
BCRYPT_ROUNDS=12

# Número de proxies à frente da API (nginx, load balancer). 0 = ligação direta.
# Sem isto atrás de um proxy, o limite de tentativas de login conta todos os clientes como um só.
TRUST_PROXY=0

# Opcional: servir o frontend compilado no mesmo processo (ex.: ../frontend/dist)
STATIC_DIR=

# Seed (npm run db:seed)
SEED_ADMIN_EMAIL=admin@plan4sustain.pt
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador P4S
# true cria uma empresa e um utilizador de demonstração
SEED_DEMO=false
