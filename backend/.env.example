NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://p4s:p4s@localhost:5432/p4s_dev

# JWT (HS256). Obrigatório, mínimo 32 caracteres. Gerar com: openssl rand -base64 48
# Fica vazio de propósito: a API não arranca sem um segredo gerado por si.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Duração máxima de uma sessão, por muito que seja renovada (30 dias)
SESSION_MAX_TTL_SECONDS=2592000

# Custo do bcrypt
BCRYPT_ROUNDS=12

# Número de proxies à frente da API. 0 = ligação direta (o próprio computador).
# Atrás de um proxy (Codespaces, nginx, Render, Railway) tem de ser 1 ou mais. Com 0 nesse caso,
# os limites de pedidos contam todos os clientes como um só e alguém de fora consegue bloquear
# o login de toda a gente. Com 1 sem proxy à frente, o limite deixa de funcionar.
TRUST_PROXY=0

# Opcional: servir o frontend compilado no mesmo processo (ex.: ../frontend/dist)
STATIC_DIR=

# Fora do próprio computador a aplicação só abre por HTTPS. Para a usar por HTTP simples numa
# rede local de confiança (sem certificado), ligue isto. A palavra-passe e a sessão passam
# então em claro nessa rede.
ALLOW_INSECURE_HTTP=false

# Análise de documentos com IA (ecrã «Documentos», só equipa P4S). Chave da API da Anthropic,
# criada em https://platform.claude.com. Vazia: a funcionalidade aparece desligada e nenhum
# documento sai do servidor. Com a chave, o TEXTO de cada documento carregado é enviado à API
# da Anthropic: confirme que os acordos de confidencialidade com os clientes o permitem.
ANTHROPIC_API_KEY=
# Modelo usado na análise
P4S_AI_MODEL=claude-opus-5-5

# O que a aplicação mostra em nome da P4S. Tudo opcional: vazio, não aparece.
# Email de contacto para quem faz a simulação sem ter conta
P4S_CONTACT_EMAIL=
# Quem emite a proposta, impresso no resumo executivo (denominação, NIF, morada)
P4S_LEGAL_IDENTITY=
# Condições da proposta impressas no resumo, separadas por «|». Exemplo de formato:
# P4S_PROPOSAL_TERMS=Primeira condição.|Segunda condição.
P4S_PROPOSAL_TERMS=

# Seed (npm run db:seed)
SEED_ADMIN_EMAIL=admin@plan4sustain.pt
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador P4S
# true cria uma empresa e um utilizador de demonstração (gestao@moldes-exemplo.test)
SEED_DEMO=false
# Palavra-passe desse utilizador. Vazia: é gerada e aparece uma só vez na consola do seed.
SEED_DEMO_PASSWORD=
