{
  "name": "p4s-stress-test",
  "version": "0.1.0",
  "description": "Plan4Sustain, stress test de qualificação industrial (API)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx db/seeds/demo.seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "22.13.1",
    "@types/pg": "8.11.11",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
